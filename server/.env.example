# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Client ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CLIENT_URL=http://localhost:5173

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/todo-app
# Docker: mongodb://mongo:27017/todo-app
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/todo-app
MONGO_URI=mongodb://localhost:27017/todo-app

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECURE=false        # Set to true in production (HTTPS only)
COOKIE_SAME_SITE=lax       # strict | lax | none

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Leave blank to disable Redis (caching + BullMQ will be skipped gracefully)
REDIS_URL=redis://localhost:6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# ─── Cloudinary ────────────────────────────────────────────────────────────────
# Leave blank to disable file uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave blank to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Todo App <noreply@todoapp.com>

# ─── App URLs ──────────────────────────────────────────────────────────────────
# Used inside email templates
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
