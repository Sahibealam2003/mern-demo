{
  "name": "todo-app-server",
  "version": "1.0.0",
  "description": "Multi-User Todo Management System - Backend API",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint src --ext .js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bullmq": "5.4.2",
    "cloudinary": "2.2.0",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-fileupload": "1.5.0",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "7.2.0",
    "firebase-admin": "^14.2.0",
    "helmet": "7.1.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.3.1",
    "nodemailer": "6.9.13",
    "socket.io": "4.7.5",
    "winston": "3.13.0",
    "zod": "3.23.4"
  },
  "devDependencies": {
    "nodemon": "3.1.0"
  },
  "nodemonConfig": {
    "ignore": [
      "node_modules",
      "logs"
    ],
    "ext": "js,json",
    "delay": 500
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
